/*
Table users {
  id serial [pk]
  name varchar
  username varchar [unique]
  email varchar [unique]
  password varchar
  created_at timestamptz
  updated_at timestamptz
}
*/

Enum metode_evaluasi {
  harga_terendah
  sistem_nilai
}

Table ref_pengadaan {
  kode_pengadaan serial [pk]
  tahun_anggaran int(4)
  no_rup int(4)
  nilai_hps int4
  kode_jenis_kontrak int4
  file_kerangka_ak varchar(255) [note: 'Kerangka Acuan Kerja']
  file_boq varchar(255) [note: 'Bill of Quantity']
  file_rancangan_kontrak varchar(255)
  kode_status_pengadaan int4
  file_s_tugas_pokja varchar(255) [note: 'Surat tugas Pokja']
  metode_evaluasi metode_evaluasi [note: 'harga_terendah, sistem_nilai']
  tgl_pengumuman_pengadaan_awal datetime
  tgl_pengumuman_pengadaan_akhir datetime
  tgl_pemberian_penjelasan_awal datetime
  tgl_pemberian_penjelasan_akhir datetime
  tgl_pemasukan_penawaran_awal datetime
  tgl_pemasukan_penawaran_akhir datetime
  tgl_pembukaan_penawaran_awal datetime
  tgl_pembukaan_penawaran_akhir datetime
  tgl_eval_klasifikasi_nego_awal datetime
  tgl_eval_klasifikasi_nego_akhir datetime
  tgl_penetapan_pengumuman_pemenang_awal datetime
  tgl_penetapan_pengumuman_pemenang_akhir datetime
  ucr varchar(80)
  uch varchar(80)
  udcr timestamptz
  udch timestamptz
}

Table ref_tahun_anggaran {
  tahun int4 [pk]
}


Enum ya_tidak {
  ya
  tidak
}

Table ref_rup_detail {
  kode_pengadaan int4 [pk]
  no_drauk int4
  sumber_dana varchar
  nama_paket varchar
  uraian_spek_kerja text
  volume_pekerjaan varchar
  satuan_volume varchar
  kode_kab_kota varchar
  detail_lokasi varchar
  tahun_anggaran int
  prod_dalam_negri ya_tidak
  is_kualifikasi_k bool
  is_kualifikasi_m bool
  is_kualifikasi_b bool
  jml_pagu decimal
  is_pra_drauk bool
  kode_jenis_pengadaan int2
  kode_kat_metode int4
  kode_metode_pengadaan int4
  tgl_renc_pemilihan_awal date
  tgl_renc_pemilihan_akhir date
  tgl_renc_pelaksanaan_awal date
  tgl_renc_pelaksanaan_akhir date
  tgl_renc_pemanfaatan_awal date
  tgl_renc_pemanfaatan_akhir date
}

Table ref_jenis_kontrak {
  kode_jenis_kontrak int4 [pk, not null]
  jenis_kontrak varchar(255)
}

Table ref_status_pengadaan {
  kode_status_pengadaan int4
  status varchar(255)
}

Table trx_surat_panutan {
  id serial [pk]
  id_trx int4
  id_panutan int4
}

Table trx_pokja_terpilih {
  kode_trx serial [pk]
  kode_pengadaan int4
  email_pokja varchar(80)
}

Table trx_undangan_kaji_ulang {
  kode_undangan serial [pk]
  kode_pengadaan int4
  tgl_undangan timestamptz
  is_online bool
  platform_konferensi varchar(100)
  link_konferensi text
  lokasi varchar(255)
  catatan text

  note: "Untuk mencatat jadwal verifikasi penyedia dengan DMAU"
}

Table trx_penerima_undangan_kaji_ulang {
  kode_trx serial [pk]
  kode_undangan int4
  email_penerima varchar(800)
}

Table trx_berita_acara_ku {
  kode_berita_acara serial [pk]
  kode_undangan int4
  is_revisi bool
}

Table ref_pertanyaan_ku {
  kode_pertanyaan serial [pk]
  pertanyaan text

  note: 'Daftar pertanyaan kaji ulang'
}

Table ref_jawaban_ku {
  kode_jawaban serial [pk]
  jawaban varchar
  is_aktif bool

  note: 'Daftar jawaban kaji ulang'
}

Table trx_pertanyaan_ku {
  kode_trx serial [pk]
  kode_berita_acara int4
  kode_pertanyaan int4
  kode_jawaban int4
  catatan text
}

Table trx_vendor_pengadaan {
  kode_trx serial [pk]
  kode_pengadaan int4
  kode_vendor int4
  nama_vendor varchar(100)
  nama_narahubung varchar(255)
  email varchar(80)
}






Ref: "ref_jenis_kontrak"."kode_jenis_kontrak" < "ref_pengadaan"."kode_jenis_kontrak"

Ref: "ref_status_pengadaan"."kode_status_pengadaan" < "ref_pengadaan"."kode_status_pengadaan"

Ref: "ref_pengadaan"."kode_pengadaan" < "trx_pokja_terpilih"."kode_pengadaan"

Ref: "trx_undangan_kaji_ulang"."kode_undangan" < "trx_penerima_undangan_kaji_ulang"."kode_undangan"

Ref: "trx_berita_acara_ku"."kode_berita_acara" < "trx_pertanyaan_ku"."kode_berita_acara"

Ref: "ref_pertanyaan_ku"."kode_pertanyaan" < "trx_pertanyaan_ku"."kode_pertanyaan"

Ref: "ref_jawaban_ku"."kode_jawaban" < "trx_pertanyaan_ku"."kode_jawaban"

Ref: "ref_pengadaan"."kode_pengadaan" < "trx_undangan_kaji_ulang"."kode_pengadaan"

Ref: "trx_undangan_kaji_ulang"."kode_undangan" < "trx_berita_acara_ku"."kode_undangan"