// ---------------------------------
// Pengeluaran Penyedia dari DPT
// ---------------------------------
Table ref_v_keluar_dpt {
  kode_v_keluar_dpt serial [pk]
  tgl_pengajuan timestamptz
  kode_vendor int4
  kode_vendor_penjr int4
  kode_sanksi_vendor int2
  teks_alasan text
  file_bukti_dukung text
  kode_status_keluar_dpt int2
  alasan_tolak_usulan text
  file_bukti_dukung_sanggahan text
  alasan_sanggahan text
  file_dokumen text
  file_surat_keputusan text
}

Table ref_sanksi_vendor {
  kode_sanksi_vendor int2 [pk]
  nama_sanksi varchar(100)
}

Table ref_status_keluar_dpt {
  kode_status_keluar_dpt serial [pk]
  status varchar(100)
}

Table trx_undangan_pemeriksaan_keluar_dpt {
  kode_undangan serial [pk]
  is_online bool
  platform_konferensi_video varchar(100)
  link_konferensi_video varchar(255)
  lokasi varchar(100)
  file_surat_ke_ppk varchar(100)
  is_terlaksana bool
}



