
Enum status_persetujuan {
  belum_diproses
  proses
  terima
  tolak
}

Enum metode_penjaringan {
  pengumuman
  undangan
}

/*
Enum status_evaluasi {
  belum_diproses
  proses_verifikasi
  perbaikan_data
  terevaluasi
}
*/

Enum jenis_item {
  "default"
  custom
}

Enum status_pengajuan_kat {
  draft
  proses_di_kasubdit
  proses_di_verifikator
  selesai
}

Enum status_pengajuan_pjr {
  draft
  proses_di_kasubdit
  proses_di_verifikator
  selesai
}

/*
Enum sertif_pengalaman {
  sertifikasi
  pengalaman
}
*/

/*
Enum jenis_personalia {
  tenaga_ahli
  tenaga_pendukung
}
*/

Enum status_vendor {
  aktif
  dibekukan
  dikeluarkan
}

Enum status_proses_pjr {
  belum_waktu_verifikasi
  proses
  proses_verifikasi
  proses_evaluasi
  selesai
}

Enum status_proses_dpt {
  belum_diumumkan
  diproses_ke_kasubdit
  selesai
}

Enum status_pembuatan_s_tugas {
  belum_diproses
  proses_ke_direktur
  selesai
}

Enum jenis_izin_usaha {
  nib
  sbu
  lainnya
}

Enum kondisi_barang {
  baik
  sedang
  kurang_baik
}


Enum status_verifikasi {
  belum_diproses
  proses_verifikasi
  perbaikan_data
  proses_evaluasi
  diterima
  ditolak
}

Enum status_dpt {
  belum_ditetapkan
  belum_penetapan
  terpilih
  tidak_terpilih
}

Table helper_kategori_kw {
  id serial [pk]
  keyword varchar
  kode_kategori int4
  kode_jenis_pengadaan int4

  note: "table sementara untuk bantu migrasi"
}

Table helper_bank_kw {
  id serial [pk]
  keyword varchar(255)
  sandi_bank varchar(4)
}

Table helper_pengusul_pjr {
  id serial [pk]
  nama_penjaringan varchar
  kode_jabatan_ppk int4

  note: "table sementara untuk bantu migrasi"
}

Table helper_domisili {
  kode_domisili int4 [pk]
  nama_domisili varchar
  kode_kab_kota varchar(5)
}

Table helper_user {
  id serial [pk]
  vms_user_id int4
  vms_user_name varchar(255)
  db_penyedia varchar(255)
  nama_penyedia varchar(255) [note: "ambil dari vmsdb.tbl_profile_penyedia.nama atau dari promise_sibela.tbl_profile_penyedia.nama"]
  jenis_penyedia varchar(255) [note: "perusahaan / perorangan"]
  kode_vendor int4
}

Table ref_bank {
  kode_bank serial [pk]
  sandi_bank varchar(4)
  nama_bank varchar(50)
}

Table ref_kbli {
  kode_kbli seria// l [pk]
  kategori varchar(2)
  gol_pokok int2
  gol int4
  sub_gol int4
  kelompok int4
  judul varchar
}


Table ref_kat_persyaratan {
  kode_kat_persyaratan serial [pk]
  kategori varchar(50)
}

Table ref_subkat_persyaratan {
  kode_subkat serial [pk]
  kode_kat_persyaratan int4
  sub_kategori varchar(100)
}

Table ref_kat_item_tanya {
  kode_kat_item_tanya serial [pk]
  kode_jenis_vendor int2
  kode_subkat int4
  kat_item_tanya varchar(200)
  nama_custom_field varchar(50)
}

Enum jenis_item_tanya {
  "default"
  custom
}

Table ref_item_tanya {
  kode_item serial [pk]
  kode_kat_item_tanya int4
  urutan int2
  nama_item varchar(100)
  nama_field varchar(50)
  tipe_input varchar(20)
  jenis_item jenis_item_tanya [note: "default, custom"]
  // nama_tabel varchar(50)
  nama_custom_field varchar(50)
  kode_penjaringan int4
  is_aktif bool
}

Table trx_ketentuan_umum_khusus {
  kode_kuk serial [pk]
  kode_penjaringan int4
  kode_subkat int4
  ket_umum varchar
  ket_khusus varchar
}

Table ref_item_tanya_tpl {
  kode_tpl serial [pk]
  kode_kat_item_tanya int4
  nama_item varchar(100)
  nama_field varchar(50)
  tipe_input varchar(20)

  note: "Master Custom Item"
}

Table ref_kategori {
  kode_kategori serial [pk]
  nama_kategori varchar

  note: 'Daftar kategori yang bisa digunakan PPK bila ada pengajuan'
}

Table ref_jenis_pengadaan {
  kode_jenis_pengadaan int2 [pk]
  jenis_pengadaan varchar

  note: "Barang, Jasa Konsultansi, Konstruksi, Jasa Lainnya"
}

/*
Table trx_kat_j_vendor {
  kode_kat_j_vendor serial [pk]
  kode_trx_kategori int4

  note: 'Untuk Input "Jenis Pelaku Usaha", Tiap trx_kategori bisa memilih jenis_vendor perorangan atau badan usaha atau dua2nya'
}
*/


Table trx_kategori {
  kode_trx_kategori serial [pk]
  kode_kategori int4 [ref: - ref_kategori.kode_kategori]
  status_persetujuan status_persetujuan [note: "Flag pengajuan paket diterima atau tidak (belum_diproses, proses, terima, tolak)"]
  keterangan_diterima text
  alasan_ditolak text
  kode_unit_pbj varchar(20) [note:'Unit yang mengajukan kategori, ambil dari ???']
  ucr varchar(80) [note: 'Email User yang membuat paket']
  uch varchar(80)
  udch timestamptz
  udcr timestamptz

  note: 'Paket pengadaan disebut dengan istilah "Kategori"'
}

Table ref_status_pengajuan_penjr {
  kode_status_pengajuan int [pk]
  status_umum varchar(30)
  status_di_ppk varchar(30)
}


Table trx_penjaringan {
  kode_penjaringan serial [pk, increment]
  kode_trx_kategori int4
  nama_penjaringan varchar(150)
  keperluan varchar(150)
  kode_jenis_pengadaan int2
  kode_jenis_vendor int2
  metode metode_penjaringan [note: "pengumuman, undangan"]
  kode_kualifikasi_usaha int2
  file_persyaratan text [note: "File PDF Persyaratan"]
  kode_status_pengajuan int4
  status_persetujuan status_persetujuan [note: "Flag pengajuan paket diterima atau tidak (belum_diproses, proses, terima, tolak)"]
  user_persetujuan varchar(80) [note: "Email user yang menerima atau menolak pengajuan penjaringan"]
  alasan_ditolak text
  status_pengajuan_pjr status_pengajuan_pjr [note: "draft, proses_di_kasubdit, proses_di_verifikator, selesai"]
  status_proses_pjr status_proses_pjr [note: "belum_waktu_verifikasi, proses, proses_verifikasi, proses_evaluasi, selesai"]
  status_pengumuman_dpt status_proses_dpt [note: "belum_diumumkan, diproses_ke_kasubdit, selesai"]
  tgl_daftar_awal timestamptz
  tgl_daftar_akhir timestamptz
  tgl_verifikasi_awal timestamptz
  tgl_verifikasi_akhir timestamptz
  tgl_evaluasi_awal timestamptz
  tgl_evaluasi_akhir timestamptz
  tgl_pengumuman timestamptz
  status_s_tugas status_pembuatan_s_tugas [note: "belum_diproses, proses_ke_direktur, selesai"]
  file_s_tugas varchar(255)
  keypass_s_tugas varchar(255)
  file_s_tugas_after_tte varchar(255)
  kode_trx_penandatangan int4
  nomor_surat varchar(100)
  file_pengumuman varchar(255)
  nama_pembuat_penjaringan varchar(100) [note: "Nama user yang mengusulkan penjaringan"]
  kode_unit_pbj varchar(20)
  ucr varchar(80) [note: "Email User yang mengusulkan penjaringan"]
  udcr timestamptz
  udch timestamptz
}



/*
Table ref_kualifikasi_penjr {
  kode_kualifikasi_penjr int2 [pk]
  kualifikasi_penjr varchar(10)

  note: "Kecil, Menengah, Besar"
}
*/

Table trx_verifikator_penjr {
  kode_verifikator_penjr serial [pk, note: "kode verifikator penjaringan"]
  kode_penjaringan int
  user_verif varchar(80) [note: "email user verifikator"]
  nama_verif varchar(100) [note: "nama verifikator"]

  note: "verifikator yang dapat surat tugas untuk memverifikasi vendor di penjaringan"
}

Table trx_undangan_penjr {
  kode_und_penjr serial [pk, note: "kode undangan penjaringan"]
  kode_penjaringan int4
  nama varchar
  email varchar
  alamat varchar
  nama_pic varchar
  no_hp_wa varchar
  tgl_awal timestamptz
  tgl_akhir timestamptz
  token varchar

  note: "Data vendor yg diundang langsung oleh PPK (metode penjaringan: 'undangan')"
}

Table trx_vendor_penjr {
  kode_vendor_penjr serial [pk]
  kode_penjaringan int4
  kode_vendor int4
  status_verifikasi status_verifikasi [note: "belum_diproses, proses_verifikasi, perbaikan_data, proses_evaluasi, diterima, ditolak"]
  alasan_ditolak text [note: "Alasan hasil evaluasi ditolak"]
  batas_waktu_perbaikan timestamptz
  file_daftar_kehadiran varchar(100)
  file_lainya varchar(100)
  file_ba_verif varchar(100)

  status_dpt status_dpt [note: "belum_ditetapkan, belum_penetapan, terpilih, tidak_terpilih"]
  alasan_tidak_terpilih text [note: "Alasan tidak terpilih sebagai DPT"]

  note: 'mencatat vendor yang memilih paket'
}

Table trx_undangan_verif {
  kode_undangan_verif serial [pk]
  kode_vendor_penjr int4
  tgl_undangan timestamptz
  is_online bool
  platform_konferensi varchar(100)
  link_konferensi text
  is_lokasi_dialamat_penyedia bool
  lokasi varchar(255)

  note: "Untuk mencatat jadwal verifikasi penyedia dengan DMAU"
}

Table trx_tim_teknis_pendukung {
  kode_tim_teknis_pendukung serial [pk]
  kode_undangan_verif int4
  email varchar(80)
  nama varchar(150)
}

Table trx_kehadiran_verif {
  kode_kehadiran serial [pk]
  kode_undangan_verif int4
  nama varchar(150)
  jabatan varchar(150)
}


Table ref_kab_kota {
  kode_kab_kota varchar(5) [pk]
  kode_provinsi varchar(5)
  kab_kota varchar
}

Table ref_jenis_vendor {
  kode_jenis_vendor int2 [pk]
  jenis_vendor varchar

  note: "Badan Usaha, Perorangan"
}

Table ref_kualifikasi_usaha {
  kode_kualifikasi_usaha int2 [pk]
  kualifikasi_usaha varchar(10)

  note: "Kecil, Menengah, Besar"
}

Table ref_vendor_register {
  kode_register serial [pk]
  kode_jenis_vendor int2
  nama_perusahaan varchar(100)
  email varchar(80)
  password varchar(100)
  no_telp varchar(30) [note: 'No Handphone whatsapp aktif kalau perorangan/ No. Telp kantor kalau badan usaha']
  nama_narahubung varchar(255)
  no_wa_narahubung varchar(20)
  swafoto varchar(100)
  status_register status_persetujuan [note: "status akun yang baru daftar (belum_diproses, proses, terima, tolak)"]
  alasan_ditolak text
  user_verif varchar(80) [note: "Email user yang memverifikasi"]
  udcr timestamptz
  udch timestamptz
  message varchar(255)
  similarity varchar(255)
  distance_percentage decimal
  distance_point decimal
  keypass varchar(255)
  kode_vendor int4 [ref: - ref_vendor.kode_vendor]

  note: "Vendor yang baru register ditampung disini dulu untuk diverifikasi"
}

Table ref_vendor_reg_history {
  kode_register serial [pk]
  kode_jenis_vendor int2
  nama_perusahaan varchar(100)
  email varchar(80)
  password varchar(100)
  no_telp varchar(30) [note: 'No Handphone whatsapp aktif kalau perorangan/ No. Telp kantor kalau badan usaha']
  nama_narahubung varchar(255)
  no_wa_narahubung varchar(20)
  swafoto varchar(100)
  status_register status_persetujuan [note: "status akun yang baru daftar (belum_diproses, proses, terima, tolak)"]
  alasan_ditolak text
  user_verif varchar(80) [note: "Email user yang memverifikasi"]
  udcr timestamptz
  udch timestamptz
  message varchar(255)
  similarity varchar(255)
  distance_percentage decimal
  distance_point decimal
  keypass varchar(255)
  kode_vendor int4 [ref: - ref_vendor.kode_vendor]

  note: "Vendor yang sudah diverifikasi (diterima/ditolak) dicatat kesini"
}

Enum status_form_dpt {
  proses
  ajukan_perubahan
  selesai
}

Table ref_vendor {
  kode_vendor serial [pk]
  kode_jenis_vendor int2
  nama_perusahaan varchar(100)
  is_tetap bool [default: false]
  status_form_luar_dpt status_form_dpt [note: "proses, ajukan_perubahan, selesai - Sebagai flag apakah vendor telah selesai mengisi form persyaratan"]
  udcr timestamptz
  udch timestamptz

  note: "Vendor adalah Penyedia - Vendor yang lolos verifikasi registrasi, disimpan disini"
}

Table ref_penanggung_jwb {
  kode_penanggung_jwb serial [pk]
  kode_vendor int4
  nik varchar(20)
  nama varchar(100)
  email varchar(80)
  jabatan varchar(100)
  file_s_kuasa text [note: "Surat Kuasa"]
  encrypt_key_s_kuasa varchar(255)
  is_aktif bool

  note: "Yang boleh TTE dari vendor"
}

Table ref_pakta_integritas {
  kode_pakta_integritas serial [pk]
  kode_vendor int4
  is_setuju bool
}

Table ref_datadiri_umum {
  kode_datadiri_umum serial [pk]
  kode_vendor int4
  nama varchar(150) [note: "Nama penyedia perorangan"]
  nama_badan_usaha varchar(150)
  nama_narahubung varchar(255) [note: 'Contact Person']
  kode_kualifikasi_usaha int2
  nomor_telp varchar(255) [note: 'Nomor telepon kantor atau rumah']
  no_handphone varchar(20) [note: 'Nomor HP Whatsapp']
  email varchar(80)
  kode_kab_kota_ktp varchar(5)
  alamat_ktp text
  kode_kab_kota_domisili varchar(5)
  alamat_domisili text
  is_alamat_sama bool [note: "Apakah alamat KTP dg Domisili sama ?"]
  file_skt text [note: "Surat Keterangan Domisili"]
  is_skt_selamanya bool [note:'Apakah Surat Keterangan Domisili berlaku selamanya?']
  skt_berlaku_awal date [default: null]
  skt_berlaku_akhir date [default: null]
  alamat_badan_usaha text

  custom jsonb

  note: "Untuk menyimpan 'Data Diri / Umum' Perorangan dan Badan Usaha"
}

Table ref_administrasi_pero {
  kode_adm serial [pk]
  kode_vendor int4

  file_skd text [note: "Surat Kebenaran Data"]
  is_skd_selamanya bool [note:'Apakah Surat Kebenaran Data berlaku selamanya?']
  skd_berlaku_awal date [default: null]
  skd_berlaku_akhir date [default: null]
  encrypt_key_skd varchar(255)

  custom_adm jsonb

  npwp varchar(20) [note: "Nomor NPWP"]
  file_npwp text
  is_npwp_selamanya bool [note:'Apakah berlaku selamanya?']
  npwp_berlaku_awal date [default: null]
  npwp_berlaku_akhir date [default: null]
  encrypt_key_npwp varchar(255)

  file_bukti_spt text
  is_bukti_spt_selamanya bool [note:'Apakah Bukti SPT berlaku selamanya?']
  bukti_spt_berlaku_awal date [default: null]
  bukti_spt_berlaku_akhir date [default: null]
  encrypt_key_bukti_spt varchar(255)

  file_skb_pph23 text [note: "Surat Keterangan Bebas PPh 23"]
  is_skb_pph23_selamanya bool [note:'Apakah selamanya?']
  skb_pph23_berlaku_awal date [default: null]
  skb_pph23_berlaku_akhir date [default: null]
  encrypt_key_skb_pph23 varchar(255)

  file_sk_pp23 text [note: "Surat Keterangan PP 23"]
  is_sk_pp23_selamanya bool [note:'Apakah berlaku selamanya?']
  sk_pp23_berlaku_awal date [default: null]
  sk_pp23_berlaku_akhir date [default: null]
  encrypt_key_sk_pp23 varchar(255)

  custom_npwp jsonb
}

Table ref_verif_administrasi_pero {
  kode_verif serial [pk]
  kode_vendor_penjr int4
  kode_adm int4

  is_file_skd_sesuai bool
  komentar_file_skd varchar(255)
  custom_adm jsonb

  is_npwp_sesuai bool
  komentar_npwp varchar(255)
  is_file_npwp_sesuai text
  komentar_file_npwp varchar(255)
  is_bukti_spt_sesuai text
  komentar_bukti_spt varchar(255)
  is_file_skb_pph23_sesuai text
  komentar_file_skb_pph23 varchar(255)
  is_file_sk_pp23_sesuai text
  komentar_file_sk_pp23 varchar(255)
  custom_npwp jsonb
}

Table trx_nilai_akhir {
  kode_penilaian serial [pk]
  kode_vendor_penjr int4

  komen_administrasi varchar(255)
  is_administrasi_lolos bool

  komen_teknis varchar(255)
  nilai_teknis int4

  komen_personalia varchar(255)
  nilai_personalia int4

  komen_kantor varchar(255)
  nilai_kantor int4

  komen_peralatan varchar(255)
  nilai_peralatan int4

  komen_pengalaman varchar(255)
  nilai_pengalaman int4

  nilai_sertifikat int4

  komen_keuangan varchar(255)
  is_keuangan_lolos bool [note: "Untuk peorangan, nilai akhir keuangan adalah lolos atau tidak lolos"]
  nilai_lap_keu int4 [note: "Untuk badan usaha, nilai akhir keuangan dinilai dengan angka"]

  nilai_total int4

  note: "hasil akhir penilaian perorangan & badan usaha di simpan disini"
}

Table ref_persentase_penilaian_tpl {
  kode_tpl int4 [pk]
  kode_jenis_vendor int4
  teknis int4
  personalia  int4
  kantor  int4
  peralatan  int4
  pengalaman  int4
  keuangan  int4
  lap_keu  int4
  sertifikat  int4
}

Table ref_persentase_penilaian {
  kode_persentase serial [pk]
  kode_penjaringan int4
  teknis int4
  personalia  int4
  kantor  int4
  peralatan  int4
  pengalaman  int4
  keuangan  int4
  lap_keu  int4
  sertifikat  int4
}

Table ref_ambang_batas_penilaian {
  kode_ambang_batas serial [pk]
  kode_penjaringan int4
  ambang_batas int4
}


Table ref_verif_datadiri_umum {
  kode_verif serial [pk]
  kode_datadiri_umum int4
  is_nama_sesuai bool
  komentar_nama varchar(255)
  is_nama_badan_usaha_sesuai bool
  komentar_nama_badan_usaha varchar(255)
  is_nama_narahubung_sesuai bool
  komentar_nama_narahubung varchar(255)
  is_kode_kualifikasi_usaha_sesuai bool
  komentar_kode_kualifikasi_usaha varchar(255)
  is_nomor_telp_sesuai bool
  komentar_nomor_telp varchar(255)
  is_nomor_handphone_sesuai bool
  komentar_nomor_handphone varchar(255)
  is_email_sesuai bool
  komentar_email varchar(255)
  is_kode_kab_kota_ktp_sesuai bool
  komentar_kode_kab_kota_ktp varchar(255)
  is_alamat_ktp_sesuai bool
  komentar_alamat_ktp varchar(255)
  is_kode_kab_kota_domisili_sesuai bool
  komentar_kode_kab_kota_domisili varchar(255)
  is_alamat_domisili_sesuai bool
  komentar_alamat_domisili varchar(255)
  is_is_alamat_sama_sesuai bool
  komentar_is_alamat_sama varchar(255)
  is_file_skt_sesuai bool
  komentar_file_skt varchar(255)
  is_alamat_badan_usaha_sesuai bool
  komentar_alamat_badan_usaha varchar(255)
  custom jsonb
}

Table ref_personalia_pero {
  kode_personalia serial [pk]
  kode_vendor int4
  nama varchar(100)
  nik varchar(20)
  tempat_lahir varchar(100)
  tgl_lahir date
  bidang_keahlian varchar(100)
  kode_jenjang_pendidikan int4
  program_studi varchar(100)

  file_ktp text
  is_ktp_selamanya bool [note:"Apakah KTP berlaku selamanya?"]
  ktp_berlaku_awal date [default: null]
  ktp_berlaku_akhir date [default: null]
  encrypt_key_ktp varchar(255)

  file_ijazah text
  is_ijazah_selamanya bool [note:"Apakah Ijazah berlaku selamanya?"]
  ijazah_berlaku_awal date [default: null]
  ijazah_berlaku_akhir date [default: null]
  encrypt_key_ijazah varchar(255)

  file_cv text
  is_cv_selamanya bool [note:"Apakah CV berlaku selamanya?"]
  cv_berlaku_awal date [default: null]
  cv_berlaku_akhir date [default: null]
  encrypt_key_cv varchar(255)

  custom_teknis jsonb

  note: "Teknis (Perorangan)"
}

table ref_pengalaman_pero {
  kode_pengalaman serial [pk]
  kode_vendor int4
  nama_pekerjaan varchar(100)
  posisi varchar(50)
  tgl_awal_pekerjaan date [default: null]
  tgl_akhir_pekerjaan date [default: null]
  nilai_pekerjaan int8
  file_bukti varchar(100)
  encrypt_key varchar
  custom jsonb
}

Table ref_sertif_pero {
  kode_sertif serial [pk]
  kode_vendor int4
  nm_sertifikat varchar(100)
  file_bukti varchar(100)
  encrypt_key varchar
  custom jsonb
}

Table ref_verif_personalia_pero {
